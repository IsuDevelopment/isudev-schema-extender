<?xml version="1.0"?>
<ruleset name="IsuDev Schema Extended">
	<description>WordPress Coding Standards for the plugin PHP sources.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="ps"/>

	<!-- Short arrays and short ternaries are intentional in this codebase. -->
	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
	</rule>

	<config name="minimum_supported_wp_version" value="6.9"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="isudev-schema-extended"/>
			</property>
		</properties>
	</rule>
</ruleset>
